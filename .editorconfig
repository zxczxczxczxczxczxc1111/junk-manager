root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml,csproj,props,slnx}]
indent_size = 2

[*.cs]
# AnalysisLevel = latest-all оставлен намеренно: он уже поймал реальное
# (CA1852 на незапечатанном типе). Правила глушатся ПОИМЁННО и с причиной,
# а не понижением планки целиком.

# CA1303: требует выносить строки в таблицу ресурсов.
# Причина отключения: весь текст для человека это русские литералы рядом с
# кодом, который их порождает, и это осознанное решение. Локализация приедет
# вместе со словарями ресурсов WPF на этапе 4, тогда правило вернуть и
# прогнать заново. До тех пор оно даёт ошибку на каждой строке сообщения.
dotnet_diagnostic.CA1303.severity = none

# CA1305/CA1310/CA1307: требуют явную культуру и StringComparison.
# НЕ отключаются: в чистильщике сравнение путей без явного
# StringComparison.OrdinalIgnoreCase это класс дефектов, а не придирка.

# CA2007: ConfigureAwait. НЕ отключается в библиотеках.
# В консольном приложении контекста синхронизации нет, поэтому там глушится
# точечно в файле, а не глобально.

[tests/**.cs]
# CA1707: подчёркивания в именах.
# Причина: имя теста это предложение, а не идентификатор API, и подчёркивания
# тут несут смысл (что_делаем_что_ожидаем). Правило написано про публичный
# контракт библиотеки, а у тестовой сборки публичного контракта нет.
dotnet_diagnostic.CA1707.severity = none

# CA1515: тип можно сделать internal.
# Причина: xunit находит тесты рефлексией по публичным типам.
dotnet_diagnostic.CA1515.severity = none

# CA2007: ConfigureAwait на каждом await.
# Причина: у тестовой сборки нет контекста синхронизации вовсе, xunit.v3
# гоняет тесты без него. Правило написано про библиотеку, которую вызовут из
# UI-потока, а здесь оно означает .ConfigureAwait(false) на каждой строке
# каждого асинхронного теста ради нуля. В БИБЛИОТЕКАХ правило остаётся: там
# оно ловит настоящий класс дефектов.
dotnet_diagnostic.CA2007.severity = none

# CA1849: синхронный File.WriteAllText внутри async-теста.
# Причина: тест раскладывает пять файлов в песочнице, чтобы потом проверить
# ОДНУ асинхронную операцию. Асинхронная раскладка не ускоряет ничего и не
# ловит ничего, а читаемость подготовки роняет. Правило написано про сервер,
# который блокирует поток пула на запросе. В БИБЛИОТЕКАХ оно остаётся: там
# синхронный вызов в async-методе это настоящий дефект.
dotnet_diagnostic.CA1849.severity = none

[src/JunkManager.Cli/**.cs]
# CA1849: синхронный Console.WriteLine внутри async-метода.
# Причина: это консольное приложение, вывод идёт в консоль, и асинхронная
# запись туда не даёт ничего, кроме перемешанных строк при параллельном
# выводе. Правило написано про сервер, который блокирует поток пула.
dotnet_diagnostic.CA1849.severity = none

# CA2007: ConfigureAwait.
# Причина: у консольного приложения нет контекста синхронизации. В библиотеках
# правило остаётся включённым, там оно ловит настоящий класс дефектов.
dotnet_diagnostic.CA2007.severity = none

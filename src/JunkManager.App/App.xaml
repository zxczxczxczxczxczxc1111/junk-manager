<Application x:Class="JunkManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:JunkManager.App.Views"
             xmlns:vm="clr-namespace:JunkManager.App.ViewModels"
             x:ClassModifier="internal">
  <!-- StartupUri не задаётся намеренно. Окно создаётся руками после решения о
       повышении, иначе запрос UAC приходит уже поверх нарисованного окна. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Dictionaries land here task by task. Order matters: Tokens first,
             everything else reads its brushes. -->
        <ResourceDictionary Source="Theme/Tokens.xaml"/>
        <ResourceDictionary Source="Theme/SystemOverrides.xaml"/>
        <ResourceDictionary Source="Theme/Controls.Buttons.xaml"/>
        <ResourceDictionary Source="Theme/Controls.Inputs.xaml"/>
        <ResourceDictionary Source="Theme/Controls.Combo.xaml"/>
        <!-- Parts before Surfaces: the StateHost style resolves the four
             templates by StaticResource, and StaticResource means "already
             loaded", not "loaded eventually". -->
        <ResourceDictionary Source="Views/Parts/EmptyState.xaml"/>
        <ResourceDictionary Source="Views/Parts/LoadingState.xaml"/>
        <ResourceDictionary Source="Views/Parts/ErrorState.xaml"/>
        <ResourceDictionary Source="Views/Parts/RestrictionNote.xaml"/>
        <ResourceDictionary Source="Views/Parts/OutcomeRow.xaml"/>
        <ResourceDictionary Source="Theme/Controls.Surfaces.xaml"/>
        <ResourceDictionary Source="Theme/Controls.Scroll.xaml"/>
        <ResourceDictionary Source="Theme/Controls.Lists.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- Экран находится по типу своей модели. Оболочка про экраны не знает
           вовсе: она кладёт в узел модель раздела, а какой контрол её рисует,
           решается здесь. Раздел без экрана кладёт null, и StateHost показывает
           заглушку из своего пустого состояния. -->
      <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
        <v:OverviewView/>
      </DataTemplate>

      <DataTemplate DataType="{x:Type vm:FilesViewModel}">
        <v:FilesView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:StorageViewModel}">
        <v:StorageView/>
      </DataTemplate>

      <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
        <v:HistoryView/>
      </DataTemplate>

      <DataTemplate DataType="{x:Type vm:RegistryViewModel}">
        <v:RegistryView/>
      </DataTemplate>

      <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <v:SettingsView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:ProgramsViewModel}">
        <v:ProgramsView/>
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>

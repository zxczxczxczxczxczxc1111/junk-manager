<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Строка выпадающего списка для VariantVybora: подпись и ничего больше.

    Ставится ЯВНО через ItemTemplate, а не через DisplayMemberPath. Проверено
    зондом 05.09.2026: при одном DisplayMemberPath свойство
    SelectionBoxItemTemplate у ComboBox остаётся null, то есть закрытый список
    рисовать ему нечем и он печатает ToString объекта. Запрет на
    DisplayMemberPath держит отдельная проверка разметки.
  -->
  <DataTemplate x:Key="VariantPodpis">
    <TextBlock Text="{Binding Podpis}"/>
  </DataTemplate>

  <!-- The closed box. Not a Button: a ToggleButton keeps the open state in the
       control itself, which is what the drop-down binds to. -->
  <Style x:Key="ComboToggleStyle" TargetType="{x:Type ToggleButton}">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="ClickMode" Value="Press"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border x:Name="Frame"
                  Background="{StaticResource SunkenBrush}"
                  BorderBrush="{StaticResource LineHiBrush}"
                  BorderThickness="1"
                  Padding="10,7">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <!-- Шаблон берётся вместе со значением. Один Content без него
                   рисует ToString объекта: закрытый список печатал
                   «VariantVybora { Podpis = Безвозвратно, ... }», а
                   DisplayMemberPath не действовал вовсе. Нашлось снимком
                   живого окна, разметка экрана при этом была правильной. -->
              <ContentPresenter Grid.Column="0"
                                Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="False"
                                TextBlock.FontFamily="{StaticResource MonoFont}"
                                TextBlock.FontSize="{StaticResource FontSizeMono}"
                                TextBlock.Foreground="{StaticResource InkBrush}"/>
              <Path x:Name="Chevron" Grid.Column="1"
                    Data="M 0,0 L 3.5,3.5 L 7,0"
                    Stroke="{StaticResource Ink3Brush}" StrokeThickness="1.6"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Stretch="None" Margin="10,0,0,0"
                    VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                  <RotateTransform x:Name="ChevronSpin" Angle="0"/>
                </Path.RenderTransform>
              </Path>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Ink3Brush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource AccentBrush}"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ChevronSpin"
                                     Storyboard.TargetProperty="Angle"
                                     To="180" Duration="{StaticResource MotionFast}">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ChevronSpin"
                                     Storyboard.TargetProperty="Angle"
                                     To="0" Duration="{StaticResource MotionFast}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type ComboBoxItem}">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBoxItem}">
          <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Path x:Name="Mark" Grid.Column="0"
                    Data="M 0,3.4 L 2.6,6 L 7.4,0.6"
                    Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Stretch="None" VerticalAlignment="Center" Opacity="0"/>
              <ContentPresenter Grid.Column="1"
                                RecognizesAccessKey="False"
                                TextBlock.FontFamily="{StaticResource MonoFont}"
                                TextBlock.FontSize="{StaticResource FontSizeMono}"
                                TextBlock.Foreground="{StaticResource Ink2Brush}"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{StaticResource RaisedBrush}"/>
            </Trigger>
            <!-- Selection is a check mark and ink weight, not a filled bar: a
                 filled row here would repeat the accent three times in a popup
                 the size of a postage stamp. -->
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Mark" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{StaticResource RaisedBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type ComboBox}">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="MinWidth" Value="150"/>
    <!-- Editable combo boxes are banned: the editable template brings a TextBox
         plus its own system chrome, and nothing in this product needs one. -->
    <Setter Property="IsEditable" Value="False"/>
    <Setter Property="MaxDropDownHeight" Value="260"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid x:Name="Root">
            <ToggleButton x:Name="PART_Toggle"
                          Style="{StaticResource ComboToggleStyle}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
            <!-- The system fade is the system look, so it is switched off on the
                 attribute below and the storyboard further down is ours. The
                 attribute is deliberately not quoted verbatim in this comment: a
                 mutation matching that text would hit the comment, change
                 nothing and report itself as a survivor. -->
            <Popup x:Name="PART_Popup"
                   Placement="Bottom" VerticalOffset="3"
                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                   AllowsTransparency="True"
                   PopupAnimation="None"
                   Focusable="False"
                   MinWidth="{Binding ActualWidth, ElementName=Root}">
              <Border x:Name="Pop"
                      Background="{StaticResource CardBrush}"
                      BorderBrush="{StaticResource LineHiBrush}"
                      BorderThickness="1"
                      Opacity="0">
                <Border.RenderTransform>
                  <TranslateTransform x:Name="PopShift" Y="-4"/>
                </Border.RenderTransform>
                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <ItemsPresenter/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsDropDownOpen" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Pop"
                                     Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource MotionFast}"/>
                    <DoubleAnimation Storyboard.TargetName="PopShift"
                                     Storyboard.TargetProperty="Y"
                                     To="0" Duration="{StaticResource MotionFast}">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Pop"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="{StaticResource MotionFast}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.35"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

  <!-- ===================================================================
       One committed dark world. There is no light theme and no switch:
       that is a decision, not an omission.
       Shared color, typography, spacing and motion tokens.
       =================================================================== -->

  <!-- Surfaces -->
  <Color x:Key="VoidColor">#FF08080A</Color>
  <Color x:Key="PanelColor">#FF0E0E11</Color>
  <Color x:Key="CardColor">#FF141418</Color>
  <Color x:Key="RaisedColor">#FF1B1B20</Color>
  <Color x:Key="SunkenColor">#FF050506</Color>

  <!-- Hairlines. Separation is a line, never a shadow and never a corner. -->
  <Color x:Key="LineColor">#FF1E1E24</Color>
  <Color x:Key="LineMidColor">#FF2B2B33</Color>
  <Color x:Key="LineHiColor">#FF3A3A44</Color>

  <!-- Ink -->
  <Color x:Key="InkColor">#FFF2F2F4</Color>
  <Color x:Key="Ink2Color">#FF9E9EA8</Color>
  <Color x:Key="Ink3Color">#FF65656E</Color>
  <!-- InkPath is not in the mockup. The mockup paints paths with Ink4, which
       measures 2.07 on the void, and the spec demands the path be visible
       without hovering. See "Расхождения макетов и спеки", пункт 2. -->
  <Color x:Key="InkPathColor">#FF7A7A85</Color>
  <!-- Decoration only: rules, disabled glyphs, never a sentence. -->
  <Color x:Key="Ink4Color">#FF44444C</Color>

  <!-- Accent. Lilac off the bucket in the icon, lifted to 7.08 on the void.
       Brand, primary action, focus ring, active section marker. Nothing else. -->
  <Color x:Key="AccentColor">#FFA88BE0</Color>
  <Color x:Key="Accent2Color">#FFB79CE8</Color>
  <Color x:Key="AccentInkColor">#FF0E0A18</Color>
  <Color x:Key="AccentLineColor">#FF3A2F55</Color>
  <!-- 30 percent lilac: the "found junk" segment of the volume strip and the
       share bar under a finding. Restored from design/obzor-varianty.html,
       where it is defined; makety.html uses it without defining it. -->
  <Color x:Key="AccentFillColor">#4DA88BE0</Color>
  <Color x:Key="AccentFill2Color">#24A88BE0</Color>

  <!-- Risk, exactly two steps of one copper hue. Badges and thin share bars
       only. This never fills a large plane and never paints a button. -->
  <Color x:Key="SafeFillColor">#FF6B4A32</Color>
  <Color x:Key="SafeInkColor">#FFB08A6B</Color>
  <Color x:Key="RiskColor">#FFE0A45F</Color>
  <Color x:Key="RiskDimColor">#38E0A45F</Color>
  <Color x:Key="CuInkColor">#FF140D05</Color>

  <!-- Irreversibility and error -->
  <Color x:Key="DangerColor">#FFE5484D</Color>
  <!-- Darker fill so white ink on the "Удалить безвозвратно" button clears 4.5.
       See "Расхождения макетов и спеки", пункт 3. -->
  <Color x:Key="DangerFillColor">#FFC93A3F</Color>

  <!-- The single "done" line in a report. Nothing else is green. -->
  <Color x:Key="OkColor">#FF3DB88B</Color>

  <!-- ==== Brushes. Frozen: they never change, and freezing skips the
       per-instance change notification plumbing. ==== -->
  <SolidColorBrush x:Key="VoidBrush"        Color="{StaticResource VoidColor}"        po:Freeze="True"/>
  <SolidColorBrush x:Key="PanelBrush"       Color="{StaticResource PanelColor}"       po:Freeze="True"/>
  <SolidColorBrush x:Key="CardBrush"        Color="{StaticResource CardColor}"        po:Freeze="True"/>
  <SolidColorBrush x:Key="RaisedBrush"      Color="{StaticResource RaisedColor}"      po:Freeze="True"/>
  <SolidColorBrush x:Key="SunkenBrush"      Color="{StaticResource SunkenColor}"      po:Freeze="True"/>
  <SolidColorBrush x:Key="LineBrush"        Color="{StaticResource LineColor}"        po:Freeze="True"/>
  <SolidColorBrush x:Key="LineMidBrush"     Color="{StaticResource LineMidColor}"     po:Freeze="True"/>
  <SolidColorBrush x:Key="LineHiBrush"      Color="{StaticResource LineHiColor}"      po:Freeze="True"/>
  <SolidColorBrush x:Key="InkBrush"         Color="{StaticResource InkColor}"         po:Freeze="True"/>
  <SolidColorBrush x:Key="Ink2Brush"        Color="{StaticResource Ink2Color}"        po:Freeze="True"/>
  <SolidColorBrush x:Key="Ink3Brush"        Color="{StaticResource Ink3Color}"        po:Freeze="True"/>
  <SolidColorBrush x:Key="InkPathBrush"     Color="{StaticResource InkPathColor}"     po:Freeze="True"/>
  <SolidColorBrush x:Key="Ink4Brush"        Color="{StaticResource Ink4Color}"        po:Freeze="True"/>
  <SolidColorBrush x:Key="AccentBrush"      Color="{StaticResource AccentColor}"      po:Freeze="True"/>
  <SolidColorBrush x:Key="Accent2Brush"     Color="{StaticResource Accent2Color}"     po:Freeze="True"/>
  <SolidColorBrush x:Key="AccentInkBrush"   Color="{StaticResource AccentInkColor}"   po:Freeze="True"/>
  <SolidColorBrush x:Key="AccentLineBrush"  Color="{StaticResource AccentLineColor}"  po:Freeze="True"/>
  <SolidColorBrush x:Key="AccentFillBrush"  Color="{StaticResource AccentFillColor}"  po:Freeze="True"/>
  <SolidColorBrush x:Key="AccentFill2Brush" Color="{StaticResource AccentFill2Color}" po:Freeze="True"/>
  <SolidColorBrush x:Key="SafeFillBrush"    Color="{StaticResource SafeFillColor}"    po:Freeze="True"/>
  <SolidColorBrush x:Key="SafeInkBrush"     Color="{StaticResource SafeInkColor}"     po:Freeze="True"/>
  <SolidColorBrush x:Key="RiskBrush"        Color="{StaticResource RiskColor}"        po:Freeze="True"/>
  <SolidColorBrush x:Key="RiskDimBrush"     Color="{StaticResource RiskDimColor}"     po:Freeze="True"/>
  <SolidColorBrush x:Key="CuInkBrush"       Color="{StaticResource CuInkColor}"       po:Freeze="True"/>
  <SolidColorBrush x:Key="DangerBrush"      Color="{StaticResource DangerColor}"      po:Freeze="True"/>
  <SolidColorBrush x:Key="DangerFillBrush"  Color="{StaticResource DangerFillColor}"  po:Freeze="True"/>
  <SolidColorBrush x:Key="OkBrush"          Color="{StaticResource OkColor}"          po:Freeze="True"/>
  <SolidColorBrush x:Key="OnDangerBrush"    Color="#FFFFFFFF"                         po:Freeze="True"/>

  <!-- ==== Type. All three families ship with Windows; nothing is embedded.
       Verified 05.09.2026 by enumerating typefaces through WPF on DERMO:
       Bahnschrift exposes real Light / 350 / Normal / SemiBold / Bold faces in
       Normal, Condensed and SemiCondensed, so FontWeight="Bold" picks a face
       and is not synthesised. Cyrillic is complete in all three (Bahnschrift
       Bold: 961 glyphs, no gaps across А-Я, а-я, Ё, ё). ==== -->
  <FontFamily x:Key="DisplayFont">Bahnschrift, Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

  <sys:Double x:Key="FontSizeH1">34</sys:Double>
  <sys:Double x:Key="FontSizeSectionTitle">17</sys:Double>
  <sys:Double x:Key="FontSizeBody">14</sys:Double>
  <sys:Double x:Key="FontSizeRow">13.5</sys:Double>
  <sys:Double x:Key="FontSizeSub">12.5</sys:Double>
  <sys:Double x:Key="FontSizeMeta">12</sys:Double>
  <sys:Double x:Key="FontSizeMono">11.5</sys:Double>
  <sys:Double x:Key="FontSizeEyebrow">11</sys:Double>
  <sys:Double x:Key="FontSizeChip">10.5</sys:Double>
  <sys:Double x:Key="FontSizePath">10.5</sys:Double>

  <!-- Tracking in em. TextBlock has no letter spacing at all, so these feed
       the TrackedText element from task 4. -->
  <sys:Double x:Key="TrackingEyebrow">0.16</sys:Double>
  <sys:Double x:Key="TrackingButton">0.11</sys:Double>
  <sys:Double x:Key="TrackingRail">0.10</sys:Double>

  <!-- ==== Metrics. Grid step 4, working values 8 / 12 / 16 / 24 / 32. ==== -->
  <sys:Double x:Key="RailWidth">200</sys:Double>
  <sys:Double x:Key="TitleBarHeight">40</sys:Double>
  <sys:Double x:Key="CaptionButtonWidth">46</sys:Double>
  <!-- GridLength, а НЕ Double. Проверено падением 05.09.2026: с sys:Double
       приложение собиралось без единого предупреждения и умирало
       XamlParseException-ом «'252' is not a valid value for property 'Width'»
       при первом показе экрана обзора, то есть через минуту после запуска и
       только на готовом результате. ColumnDefinition.Width это GridLength, и
       преобразователь типов работает для СТРОКИ в разметке, а не для уже
       разобранного ресурса. -->
  <GridLength x:Key="CategoryColumnWidth">252</GridLength>
  <sys:Double x:Key="ScrollBarThickness">10</sys:Double>
  <sys:Double x:Key="DiskStripHeight">10</sys:Double>
  <sys:Double x:Key="CheckBoxSize">15</sys:Double>

  <Thickness x:Key="PadScreen">26,24,26,30</Thickness>
  <Thickness x:Key="PadRow">18,13</Thickness>
  <Thickness x:Key="PadCell">16,11</Thickness>
  <Thickness x:Key="PadButton">15,9</Thickness>
  <Thickness x:Key="PadButtonSmall">10,5</Thickness>
  <Thickness x:Key="HairlineBottom">0,0,0,1</Thickness>

  <!-- ==== Motion. 150 to 200 ms with easing, and zero when the system asks
       for reduced motion. App.xaml.cs rewrites both keys at startup through
       MotionPolicy. ==== -->
  <Duration x:Key="MotionFast">0:0:0.15</Duration>
  <Duration x:Key="MotionMedium">0:0:0.20</Duration>
  <sys:Boolean x:Key="MotionEnabled">True</sys:Boolean>

</ResourceDictionary>

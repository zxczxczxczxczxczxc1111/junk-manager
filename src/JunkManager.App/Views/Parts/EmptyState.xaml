<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:JunkManager.App.Converters"
                    xmlns:behaviors="clr-namespace:JunkManager.App.Controls.Behaviors">

  <conv:BoolToVisibilityConverter x:Key="VisibleWhenTrue"/>

  <!-- Nothing found is not an error and does not look like one: outline glyph in
       Ink4, no red, no exclamation. The body says what was checked, because
       "пусто" without that reads as "инструмент не работает". -->
  <DataTemplate x:Key="EmptyStateTemplate">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
      <StackPanel>
        <StackPanel x:Name="WelcomeMark" behaviors:WelcomeEntrance.Enabled="{Binding IsWelcome}" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,0,0,26">
          <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
          <Image Source="pack://application:,,,/Assets/welcome-logo.png" Width="180" Height="180"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 AutomationProperties.Name="Junk Manager: смайлик с ведром"
                 AutomationProperties.AutomationId="welcome-logo"/>
          <TextBlock Text="Junk Manager" FontFamily="{StaticResource DisplayFont}" FontSize="32"
                     Foreground="{StaticResource InkBrush}" TextAlignment="Center" Margin="0,18,0,0"/>
        </StackPanel>
        <Path x:Name="EmptyGlyph" Data="M 6,9 H 42 V 20 H 6 Z M 6,26 H 27 V 37 H 6 Z"
              Stroke="{StaticResource Ink4Brush}" StrokeThickness="1.8"
              Fill="Transparent" Stretch="None"
              HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Text="{Binding EmptyTitle}"
                   FontFamily="{StaticResource DisplayFont}"
                   FontSize="{StaticResource FontSizeSectionTitle}"
                   Foreground="{StaticResource InkBrush}"
                   TextAlignment="Center" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="empty-title"/>

        <TextBlock Text="{Binding EmptyBody}"
                   FontFamily="{StaticResource TextFont}"
                   FontSize="{StaticResource FontSizeSub}"
                   Foreground="{StaticResource Ink2Brush}"
                   TextAlignment="Center" TextWrapping="Wrap"
                   LineHeight="19" Margin="0,10,0,0"
                   AutomationProperties.AutomationId="empty-body"/>

        <!-- Команда приходит из модели состояния вместе с подписью, а не из
             предка по дереву: подпись без команды это кнопка, которая ничего
             не делает, и разъехаться они не могут, раз ставятся одним вызовом. -->
        <Button Content="{Binding EmptyAction}"
                Command="{Binding EmptyCommand}"
                Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Center" Margin="0,20,0,0"
                Visibility="{Binding EmptyAction,
                             Converter={StaticResource VisibleWhenTrue}}"
                AutomationProperties.AutomationId="empty-action"/>
      </StackPanel>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsWelcome}" Value="True">
        <Setter TargetName="WelcomeMark" Property="Visibility" Value="Visible"/>
        <Setter TargetName="EmptyGlyph" Property="Visibility" Value="Collapsed"/>

      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:JunkManager.App.Converters">
  <conv:BoolToVisibilityConverter x:Key="ErrorRetryVisible"/>

  <!-- The only place a triangle and Danger red are allowed on a screen body.
       The body carries the actual reason, with the file and the position in it:
       "что-то пошло не так" is a sentence nobody can act on. -->
  <DataTemplate x:Key="ErrorStateTemplate">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
      <StackPanel>
        <Path Data="M 24,6 L 45,42 L 3,42 Z M 24,19 V 29"
              Stroke="{StaticResource DangerBrush}" StrokeThickness="1.8"
              StrokeLineJoin="Round" Fill="Transparent" Stretch="None"
              HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Text="{Binding ErrorTitle}"
                   FontFamily="{StaticResource DisplayFont}"
                   FontSize="{StaticResource FontSizeSectionTitle}"
                   Foreground="{StaticResource InkBrush}"
                   TextAlignment="Center" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="error-title"/>

        <TextBlock Text="{Binding ErrorBody}"
                   FontFamily="{StaticResource TextFont}"
                   FontSize="{StaticResource FontSizeSub}"
                   Foreground="{StaticResource Ink2Brush}"
                   TextAlignment="Center" TextWrapping="Wrap"
                   LineHeight="19" Margin="0,10,0,0"
                   AutomationProperties.AutomationId="error-body"/>
        <Button Content="Повторить" Command="{Binding RetryCommand}" HorizontalAlignment="Center" Margin="0,18,0,0"
                Visibility="{Binding RetryCommand, Converter={StaticResource ErrorRetryVisible}}"
                AutomationProperties.AutomationId="error-retry"/>
      </StackPanel>
    </Grid>
  </DataTemplate>

</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:JunkManager.App.Converters">

  <conv:BoolToVisibilityConverter x:Key="RestrictionVisibleWhenTrue"/>

  <!-- Lilac and not copper. Copper is a risk tier and nothing else; a missing
       right is not a risk tier, it is a hole in what was checked. The wording
       rule lives here too: this note always says what was NOT looked at, never
       that nothing was found. -->
  <DataTemplate x:Key="RestrictionNoteTemplate">
    <Border Background="{StaticResource AccentFill2Brush}"
            BorderBrush="{StaticResource AccentLineBrush}"
            BorderThickness="1"
            Padding="14,11">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Path Grid.Column="0"
              Data="M 4,8.6 H 16 V 16.4 H 4 Z M 6.9,8.6 V 6.1 A 3.1,3.1 0 0 1 13.1,6.1 V 8.6"
              Stroke="{StaticResource AccentBrush}" StrokeThickness="1.4"
              Fill="Transparent" Stretch="None"
              VerticalAlignment="Top" Margin="0,1,12,0"/>

        <StackPanel Grid.Column="1">
        <TextBlock
                   Text="{Binding RestrictionText}"
                   FontFamily="{StaticResource TextFont}"
                   FontSize="{StaticResource FontSizeSub}"
                   Foreground="{StaticResource Ink2Brush}"
                   TextWrapping="Wrap" LineHeight="18"
                   AutomationProperties.AutomationId="restriction-note"/>
        <Button Content="Подробности" Margin="0,8,0,0" HorizontalAlignment="Left"
                  Style="{StaticResource SmallButton}"
                  Command="{Binding ToggleRestrictionDetailsCommand}"
                  Visibility="{Binding RestrictionDetails, Converter={StaticResource RestrictionVisibleWhenTrue}}"
                  AutomationProperties.AutomationId="restriction-details-toggle"/>
          <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        Visibility="{Binding RestrictionDetailsOpen, Converter={StaticResource RestrictionVisibleWhenTrue}}">
            <TextBlock Text="{Binding RestrictionDetails}" TextWrapping="Wrap"
                       LineHeight="18" Margin="0,8,8,0"
                       AutomationProperties.AutomationId="restriction-details"/>
          </ScrollViewer>
        </StackPanel>
      </Grid>
    </Border>
  </DataTemplate>

</ResourceDictionary>

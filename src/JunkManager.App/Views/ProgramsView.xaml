<UserControl x:Class="JunkManager.App.Views.ProgramsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:JunkManager.App.Converters"
             x:ClassModifier="internal">
  <UserControl.Resources>
    <conv:BoolToVisibilityConverter x:Key="Visible"/>
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <DataTemplate x:Key="ProgramPreview">
      <StackPanel Margin="12,8">
        <TextBlock Text="{Binding Name}" FontSize="16"/>
        <TextBlock Text="{Binding Details}" Foreground="{StaticResource Ink2Brush}" Margin="0,4,0,0"/>
        <TextBlock Text="{Binding RemovalDescription}" Foreground="{StaticResource Ink2Brush}"/>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="LeftoverPreview">
      <StackPanel Margin="12,8">
        <TextBlock Text="{Binding Path}"/>
        <TextBlock Text="{Binding Explanation}" Foreground="{StaticResource Ink2Brush}" Margin="0,4,0,0"/>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <!-- Virtualized rows: installing fifty launchers should not also install fifty layout passes. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18">
      <TextBlock Text="ПРОГРАММЫ" Foreground="{StaticResource Ink3Brush}" FontSize="11"/>
      <TextBlock Text="Установленные приложения" FontFamily="{StaticResource DisplayFont}" FontSize="30" Margin="0,6,0,0"/>
    </StackPanel>
    <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
            Padding="12" Margin="0,0,0,14" Visibility="{Binding Notice, Converter={StaticResource Visible}}">
      <TextBlock Text="{Binding Notice}" Foreground="{StaticResource Ink2Brush}" AutomationProperties.AutomationId="apps-notice"/>
    </Border>

    <Grid Grid.Row="2" Visibility="{Binding IsSelection, Converter={StaticResource Visible}}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=180}" Margin="0,0,12,0"
                 AutomationProperties.Name="Поиск по названию или издателю" AutomationProperties.AutomationId="apps-search"/>
        <ComboBox Grid.Column="1" ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SortIndex}" Margin="0,0,12,0"
                  AutomationProperties.Name="Сортировка программ" AutomationProperties.AutomationId="apps-sort"/>
        <Button Grid.Column="2" Content="Обновить" Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="apps-refresh"/>
      </Grid>
      <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" HorizontalContentAlignment="Stretch"
               VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
               ScrollViewer.CanContentScroll="True" AutomationProperties.AutomationId="apps-list">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Margin="10,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
              <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Center" Margin="0,0,14,0"
                        AutomationProperties.Name="{Binding Name}" AutomationProperties.AutomationId="app-select"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Name}" FontSize="16"/>
                <TextBlock Text="{Binding Details}" Foreground="{StaticResource Ink2Brush}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding Refusal}" Foreground="{StaticResource Ink3Brush}"
                           Visibility="{Binding Refusal, Converter={StaticResource Visible}}"/>
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding Size}" ToolTip="{Binding SizeDetail}" AutomationProperties.AutomationId="app-size" Foreground="{StaticResource Ink2Brush}" TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Grid.Row="1" Text="Подходящих программ нет. Измените поиск или обновите список."
                 HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Ink2Brush}"
                 Visibility="{Binding NoMatches, Converter={StaticResource Visible}}" AutomationProperties.AutomationId="apps-empty"/>
      <DockPanel Grid.Row="2" Margin="0,16,0,0">
        <Button DockPanel.Dock="Right" Content="Удалить выбранные" Command="{Binding ReviewRemovalCommand}"
                Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="apps-review"/>
        <TextBlock Text="{Binding SelectionSummary}" VerticalAlignment="Center" AutomationProperties.AutomationId="apps-selection"/>
      </DockPanel>
    </Grid>

    <Grid Grid.Row="2" Visibility="{Binding IsConfirmRemoval, Converter={StaticResource Visible}}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,18">
        <TextBlock Text="Удалить эти программы?" FontSize="22"/>
        <TextBlock Text="Программы удалятся по очереди через их штатные деинсталляторы. Может открыться мастер удаления. Копия программы не создаётся. Остатки можно будет выбрать отдельно после проверки результата."
                   Foreground="{StaticResource Ink2Brush}" Margin="0,10,0,0"/>
      </StackPanel>
      <ListBox Grid.Row="1" ItemsSource="{Binding SelectedPrograms}" ItemTemplate="{StaticResource ProgramPreview}"
               HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="apps-confirm-list"/>
      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,18,0,0">
        <Button Content="Назад" Command="{Binding BackCommand}" Margin="0,0,12,0" AutomationProperties.AutomationId="apps-back"/>
        <Button Content="Подтвердить удаление" Command="{Binding RemoveCommand}" Style="{StaticResource PrimaryButton}"
                AutomationProperties.AutomationId="apps-confirm-remove"/>
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="2" VerticalAlignment="Center" MaxWidth="600" HorizontalAlignment="Stretch"
                Visibility="{Binding ShowProgress, Converter={StaticResource Visible}}">
      <TextBlock Text="Выполняется операция" FontSize="24"/>
      <ProgressBar IsIndeterminate="True" Height="3" Margin="0,18,0,18"/>
      <TextBlock Text="{Binding Activity}" AutomationProperties.AutomationId="apps-activity"/>
      <TextBlock Text="Отмена остановит очередь и ожидание. Уже запущенный деинсталлятор сможет завершить работу."
                 Foreground="{StaticResource Ink2Brush}" Margin="0,10,0,18"/>
      <StackPanel Visibility="{Binding WaitingForDecision, Converter={StaticResource Visible}}" Margin="0,0,0,18">
        <TextBlock Text="Удаление занимает больше пяти минут. Продолжать ждать?"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Button Content="Продолжить ожидание" Command="{Binding ContinueWaitingCommand}" Margin="0,0,12,0" AutomationProperties.AutomationId="apps-continue-waiting"/>
          <Button Content="Перестать ждать" Command="{Binding StopWaitingCommand}" AutomationProperties.AutomationId="apps-stop-waiting"/>
        </StackPanel>
      </StackPanel>
      <Button Content="Остановить очередь" Command="{Binding CancelCommand}" HorizontalAlignment="Left"
              AutomationProperties.AutomationId="apps-cancel"/>
    </StackPanel>

    <Grid Grid.Row="2" Visibility="{Binding IsReport, Converter={StaticResource Visible}}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="{Binding Summary}" FontSize="20" Margin="0,0,0,14" AutomationProperties.AutomationId="apps-summary"/>
      <ListBox Grid.Row="1" ItemsSource="{Binding Results}" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="apps-results">
        <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="10,7">
          <TextBlock Text="{Binding Name}"/>
          <TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" Margin="0,3,0,0"/>
          <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Ink2Brush}"/>
        </StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.Row="2" Margin="0,16,0,12">
        <TextBlock Text="Остатки после удаления" FontSize="20"/>
        <TextBlock Text="Выберите нужные объекты. Совпадения только по имени показаны для справки и недоступны для удаления."
                   Foreground="{StaticResource Ink2Brush}" Margin="0,6,0,0"/>
      </StackPanel>
      <ListBox Grid.Row="3" ItemsSource="{Binding Leftovers}" HorizontalContentAlignment="Stretch"
               VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
               AutomationProperties.AutomationId="apps-leftovers">
        <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="10,7">
          <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" Margin="0,0,14,0"
                    AutomationProperties.Name="{Binding Path}" AutomationProperties.AutomationId="app-leftover-select"/>
          <StackPanel><TextBlock Text="{Binding Path}"/>
            <TextBlock Text="{Binding Explanation}" Foreground="{StaticResource Ink2Brush}" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding Confidence}" Foreground="{StaticResource Ink3Brush}"/>
          </StackPanel>
        </DockPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Grid.Row="3" Text="Подтверждённых остатков для очистки нет" HorizontalAlignment="Center"
                 VerticalAlignment="Center" Foreground="{StaticResource Ink2Brush}" AutomationProperties.AutomationId="apps-leftovers-empty">
        <TextBlock.Style><Style TargetType="TextBlock">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers><DataTrigger Binding="{Binding Leftovers.Count}" Value="0">
            <Setter Property="Visibility" Value="Visible"/>
          </DataTrigger></Style.Triggers>
        </Style></TextBlock.Style>
      </TextBlock>
      <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,18,0,0">
        <Button Content="Обновить программы" Command="{Binding RefreshCommand}" Margin="0,0,12,0" AutomationProperties.AutomationId="apps-report-refresh"/>
        <Button Content="Очистить выбранные остатки" Command="{Binding ReviewLeftoversCommand}"
                Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="apps-review-leftovers"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2" Visibility="{Binding IsConfirmLeftovers, Converter={StaticResource Visible}}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,18">
        <TextBlock Text="Очистить выбранные остатки?" FontSize="22"/>
        <TextBlock Text="{Binding CleanupNote}" Foreground="{StaticResource Ink2Brush}" Margin="0,10,0,0"/>
      </StackPanel>
      <ListBox Grid.Row="1" ItemsSource="{Binding SelectedLeftovers}" ItemTemplate="{StaticResource LeftoverPreview}"
               HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="apps-confirm-leftovers-list"/>
      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,18,0,0">
        <Button Content="Назад" Command="{Binding BackCommand}" Margin="0,0,12,0" AutomationProperties.AutomationId="apps-leftovers-back"/>
        <Button Content="Подтвердить очистку" Command="{Binding CleanLeftoversCommand}" Style="{StaticResource PrimaryButton}"
                AutomationProperties.AutomationId="apps-confirm-clean"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>

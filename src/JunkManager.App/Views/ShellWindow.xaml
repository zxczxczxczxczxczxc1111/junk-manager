<Window x:Class="JunkManager.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:JunkManager.App.Controls.Behaviors"
        xmlns:c="clr-namespace:JunkManager.App.Controls"
        xmlns:vm="clr-namespace:JunkManager.App.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Junk Manager"
        Height="900" Width="1920" MinHeight="720" MinWidth="1180"
        Background="{StaticResource VoidBrush}"
        Foreground="{StaticResource InkBrush}"
        FontFamily="{StaticResource TextFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        b:WindowChromeCommands.Enabled="True"
        b:PodgonPodEkran.Enabled="True"
        AutomationProperties.AutomationId="shell-window"
        x:ClassModifier="internal">

  <!-- The window loses its frame here and gets it back drawn by us. CaptionHeight
       stays equal to the title bar: at zero nothing drags the window at all,
       because the whole surface becomes client area. The three caption buttons
       opt back out with IsHitTestVisibleInChrome. -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="{StaticResource TitleBarHeight}"
                        ResizeBorderThickness="6"
                        CornerRadius="0"
                        GlassFrameThickness="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <!-- Имя нужно привязке рельсы ниже. Через предка-Window она НЕ разрешается
       в наборе проверок: стенд отрывает содержимое от окна и вешает его прямо
       в HwndSource, поэтому предка Window в дереве нет вовсе. Раньше это
       значило, что команда рельсы не проверялась ничем: ошибка привязки в WPF
       молчит, а ловушки на неё в наборе не было. Найдено 06.09.2026. -->
  <Grid x:Name="KorenSoderzhimogo">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ==== Title bar ==== -->
    <Grid Grid.Row="0" Background="{StaticResource PanelBrush}"
          Height="{StaticResource TitleBarHeight}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <Image Grid.Column="0" Source="pack://application:,,,/Assets/icon-20.png"
             Width="16" Height="16" Margin="14,0,10,0"
             VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>

      <TextBlock Grid.Column="1" Text="Junk Manager"
                 FontFamily="{StaticResource TextFont}"
                 FontSize="{StaticResource FontSizeMeta}"
                 Foreground="{StaticResource Ink2Brush}"
                 VerticalAlignment="Center"/>

      <!-- Rights are stated in the title bar and never hidden behind a menu:
           what the product is allowed to touch changes what the numbers below
           mean, and that belongs where it is always visible. -->
      <Border Grid.Column="2" HorizontalAlignment="Left"
              Margin="12,0,0,0" Padding="7,2"
              VerticalAlignment="Center"
              BorderThickness="1">
        <Border.Style>
          <Style TargetType="{x:Type Border}">
            <Setter Property="BorderBrush" Value="{StaticResource AccentLineBrush}"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsElevated}" Value="False">
                <Setter Property="BorderBrush" Value="{StaticResource LineMidBrush}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <!-- Идентификатор на ПОДПИСИ, а не на рамке вокруг неё. У Border нет
             элемента автоматизации вовсе, поэтому «rights-badge» на рамке был
             украшением: живой прогон 05.09.2026 не нашёл его в дереве при
             правильной разметке. У TextBlock элемент есть, и его имя это его
             же текст, то есть ровно то, что нужно прочитать. -->
        <TextBlock Text="{Binding RightsLabel}"
                   FontFamily="{StaticResource MonoFont}"
                   FontSize="{StaticResource FontSizeChip}"
                   AutomationProperties.AutomationId="rights-badge">
          <TextBlock.Style>
            <Style TargetType="{x:Type TextBlock}">
              <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsElevated}" Value="False">
                  <Setter Property="Foreground" Value="{StaticResource Ink3Brush}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Border>

      <StackPanel Grid.Column="3" Orientation="Horizontal"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Style="{StaticResource CaptionButton}"
                Tag="M 0,5 H 10"
                Command="{x:Static b:WindowChromeCommands.Minimize}"
                AutomationProperties.Name="Свернуть"
                AutomationProperties.AutomationId="caption-minimize"/>
        <Button Style="{StaticResource CaptionButton}"
                Tag="M 0,0 H 10 V 10 H 0 Z"
                Command="{x:Static b:WindowChromeCommands.ToggleMaximize}"
                AutomationProperties.Name="Развернуть"
                AutomationProperties.AutomationId="caption-maximize"/>
        <Button Style="{StaticResource CaptionButton}"
                Tag="M 0,0 L 10,10 M 10,0 L 0,10"
                Command="{x:Static b:WindowChromeCommands.Close}"
                AutomationProperties.Name="Закрыть"
                AutomationProperties.AutomationId="caption-close"/>
      </StackPanel>
    </Grid>

    <!-- ==== Rail plus screen ==== -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
              Width="{StaticResource RailWidth}"
              BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <ItemsControl Grid.Row="0" ItemsSource="{Binding Sections}"
                        Margin="0,12,0,0"
                        KeyboardNavigation.DirectionalNavigation="Cycle"
                        KeyboardNavigation.TabNavigation="Once"
                        AutomationProperties.AutomationId="rail">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:SectionViewModel}">
                <Button Style="{StaticResource RailItemStyle}"
                        Command="{Binding DataContext.VybratCommand,
                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        AutomationProperties.Name="{Binding Title}"
                        AutomationProperties.ItemStatus="{Binding IsCurrent}"
                        AutomationProperties.AutomationId="{Binding AutomationId}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Подвала у рельса нет намеренно. Он показывал «правил 38» и
               «права подняты при запуске»: первое человеку решать нечего,
               второе уже висит плашкой rights-badge в шапке окна. Число
               правил осталось там, где оно что-то объясняет, в оценке
               длительности прохода на «Обзоре». -->
        </Grid>
      </Border>

      <!-- Экран сам. Content это модель экрана раздела, а какой контрол её
           рисует, решает шаблон данных из App.xaml. Раздел без экрана кладёт
           сюда null, и фаза у него Empty, то есть виден не пустой прямоугольник,
           а заглушка со своим текстом. -->
      <c:StateHost Grid.Column="1"
                   Phase="{Binding Current.State.Phase}"
                   State="{Binding Current.State}"
                   HasRestriction="{Binding Current.State.HasRestriction}"
                   Content="{Binding Current.Screen}"
                   Margin="{StaticResource PadScreen}"
                   AutomationProperties.AutomationId="screen-host"/>
    </Grid>
  </Grid>
</Window>

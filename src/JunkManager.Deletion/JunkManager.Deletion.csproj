<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Microsoft ships the projection; generating another one only feeds the SDK furnace. -->
    <CsWinRTGenerateProjection>false</CsWinRTGenerateProjection>
    <MicrosoftManagementDeployment-Platform>x64</MicrosoftManagementDeployment-Platform>
    <MicrosoftManagementDeployment-FactoryLinkage>static</MicrosoftManagementDeployment-FactoryLinkage>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <PackageReference Include="Microsoft.WindowsPackageManager.ComInterop" Version="1.10.340" GeneratePathProperty="true" />
    <!-- Native COM activation must travel through project references too. Teleportation is not a publish target. -->
    <Content Include="$(PkgMicrosoft_WindowsPackageManager_ComInterop)\bin\win-x64\native\static\Microsoft.Management.Deployment.dll"
             Link="Microsoft.Management.Deployment.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The native factory needs metadata for COM marshaling; missing it makes every interface an unidentified object. -->
    <Content Include="$(PkgMicrosoft_WindowsPackageManager_ComInterop)\lib\uap10.0\Microsoft.Management.Deployment.winmd"
             Link="Microsoft.Management.Deployment.winmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JunkManager.Safety\JunkManager.Safety.csproj" />
    <!--
      Ссылка на Core появилась вместе с исполнителем платформенных утилит.
      Причина: Purge, StartComponentCleanup и delete-driver разрушительны и
      обязаны жить тут, а сборщики команд и разбор вывода живут в Core.
      Обратной ссылки не возникает: Core про Deletion по-прежнему не знает, и
      правило «удаляет только Deletion» от этого крепнет, а не слабеет.
    -->
    <ProjectReference Include="..\JunkManager.Core\JunkManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Внутреннее видно набору тестов. Открыто ровно одно: чистая функция
      RebootDeleteScheduler.Otkaz, которая отвечает «почему откажем» без
      обращения к системе. Публичной её делать нечестно (параметр elevated
      снаружи брать неоткуда), а проверить обязательно: под администратором
      ветку отказа иначе не достать вовсе.
    -->
    <InternalsVisibleTo Include="JunkManager.Tests" />
  </ItemGroup>

</Project>
